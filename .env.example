# Set real values only in backend secret settings or a git-ignored .env file.
APP_AUTH_TOKEN=
OPENAI_API_KEY=
# Choose a Responses-compatible model available to your API account.
PLANNER_MODEL=
MANAGER_MODEL=
# Separate trusted runtime service implementing docs/delivery-runtime.md.
CODING_RUNTIME_URL=
CODING_RUNTIME_TOKEN=
# Runtime service settings (configure separately on the isolated runtime host).
RUNTIME_PUBLIC_URL=
RUNTIME_REPOSITORIES_FILE=
RUNTIME_DATABASE_PATH=./runtime-data/operations.sqlite
RUNTIME_WORKSPACE_ROOT=./runtime-data/workspaces
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=3100
CODEX_EXECUTABLE=codex
CODING_MODEL=
# Coding runtime gets only the release service's limited API credentials.
RELEASE_SERVICE_URL=
RELEASE_SERVICE_TOKEN=
# The following belong on the SEPARATE trusted release host only.
RELEASE_PUBLIC_URL=
RELEASE_REPOSITORIES_FILE=
RELEASE_DATABASE_PATH=./release-data/releases.sqlite
RELEASE_HOST=127.0.0.1
RELEASE_PORT=3200
GITHUB_RELEASE_TOKEN=
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/platform.sqlite
MAX_PLANNING_TURNS=100
PLANNER_MAX_OUTPUT_TOKENS=3000
